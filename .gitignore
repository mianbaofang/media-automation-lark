# Local secrets and user config
.env
.env.*
config.json

# Runtime outputs
output/
output_*/
reports/*.tmp
# Keep source-level Skill evaluation fixtures versioned; runtime output dirs
# elsewhere remain ignored by the rules above.
!evals/
!evals/output/
!evals/output/**
hyperframes/**/renders/
hyperframes/**/snapshots/

# Python cache and test cache
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/

# Virtual environments
.venv/
venv/

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local browser captures and private source media
.playwright-cli/
mp4/
